    "faq": {
      "type": "studio-original-feature",
      "settings": {
        "kind": "faq",
        "heading": "Common Questions",
        "kicker": "#",
        "copy": "Got questions? We have answers to help you feel more at ease.",
        "button_label": "Ask the Studio",
        "button_link": "/pages/contact"
      },
      "blocks": {
        "block_1": {
          "type": "question",
          "settings": {
            "question": "How do I book an appointment?",
            "answer": "<p>Choose your service and contact the studio to confirm your artist, appointment time, and booking details. <a href=\"/pages/book\">Explore booking options.</a></p>"
          }
        },
        "block_2": {
          "type": "question",
          "settings": {
            "question": "What aftercare should I follow for my tattoo?",
            "answer": "<p>Follow the written instructions your artist gives you for your tattoo and dressing. Contact the studio if you need those instructions again. <a href=\"/pages/aftercare\">Find aftercare contacts.</a></p>"
          }
        },
        "block_3": {
          "type": "question",
          "settings": {
            "question": "Can I customize my tattoo design?",
            "answer": "<p>Bring your ideas, sketches, or inspiration. Your artist will explain the color, shading, and design options that fit your selected piece.</p>"
          }
        },
        "block_4": {
          "type": "question",
          "settings": {
            "question": "What should I expect during my session?",
            "answer": "<p>Your session begins with a consultation about the design and your preferences. Your artist will explain the process and help you feel comfortable before starting.</p>"
          }
        },
        "block_5": {
          "type": "question",
          "settings": {
            "question": "Can I get a piercing during my visit?",
            "answer": "<p>Let the studio know when you book if you’re interested in a piercing too. The team can check availability for both services.</p>"
          }
        }
      },
      "block_order": [
        "block_1",
        "block_2",
        "block_3",
        "block_4",
        "block_5"
      ]
