        "compact": true
      },
      "blocks": {
        "block_1": {
          "type": "story",
          "settings": {
            "heading": "Spin to Win!",
            "copy": "Experience the thrill of our Ink Roulette! Spin the wheel and discover what design awaits you. It’s an exciting way to find your next tattoo, making your choice easy and fun."
          }
        },
        "block_2": {
          "type": "story",
          "settings": {
            "heading": "Join the Fun!",
            "copy": "Everyone gets a chance to explore their creativity with our unique Ink Roulette. Each spin brings a surprise, leading you to a new and unexpected tattoo."
          }
        },
        "block_3": {
          "type": "story",
          "settings": {
            "heading": "Ready to Spin?",
            "copy": "Come by, give the wheel a spin, and let the adventure of body art unfold just for you.",
            "link_label": "Talk to the studio",
            "link": "/pages/contact"
          }
        }
      },
      "block_order": [
        "block_1",
