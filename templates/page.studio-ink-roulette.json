    "reviews": {
      "type": "studio-original-feature",
      "settings": {
        "kind": "reviews",
        "heading": "What Our Clients Are Saying",
        "kicker": "#",
        "copy": "#",
        "tone": "red"
      },
      "blocks": {
        "block_1": {
          "type": "review",
          "settings": {
            "quote": "Just got my lobes pierced! They’re the 3rd ones on both sides, the process was quick and painless and the guys there were super friendly! Loved the experience!",
            "author": "Faith Deaton",
            "source_label": "Ear Piercing",
            "source_url": "https://sideshowproductionstattoo.com/ink-roulette/"
          }
        },
        "block_2": {
          "type": "review",
          "settings": {
            "quote": "Jake is awesome! Me and my cousin got matching tattoos and he did exactly what we wanted. They came out so great. Professional, clean and quick to respond. Will be coming back for my next tattoo!",
            "author": "Ranithri Slayton",
            "source_label": "Tattoo Design",
            "source_url": "https://sideshowproductionstattoo.com/ink-roulette/"
          }
        },
        "block_3": {
          "type": "review",
          "settings": {
            "quote": "Solid prices great work Jake makes sure your really comfortable highly recommend",
            "author": "Carlos Tarazon",
            "source_label": "Tattoo Design | Memorial Tattoo",
            "source_url": "https://sideshowproductionstattoo.com/ink-roulette/"
          }
        },
        "block_4": {
          "type": "review",
          "settings": {
            "quote": "Had a tattoo with Jake and it was the BEST tattoo experience I have ever had. Most painless tattoo EVER. Like literally almost fell asleep (in a good way lol). They're healing super well. Was given a second piece of second skin to apply later if it pealed and was wrapped up super well before leaving. Clean shop. And felt comfortable from the start of my appt.",
            "author": "Hayley Ainsworth",
            "source_label": "Flash Tattoo",
            "source_url": "https://sideshowproductionstattoo.com/ink-roulette/"
          }
        }
      },
      "block_order": [
        "block_1",
        "block_2",
        "block_3",
        "block_4"
      ]
    },
    "experience": {
      "type": "studio-original-feature",
      "settings": {
        "kind": "media",
        "heading": "Discover Our Ink Roulette Experience",
        "kicker": "#",
        "copy": "Spin the wheel for $150 and get two chances. Choose your favorite number from the spins, pick a design from the board, and customize it with color or shading. Prefer a different number? Choosing another number is an additional $20.",
        "video_asset": "sp-original-detail-roulette.mp4",
        "poster": "sp-original-detail-roulette-poster.webp",
        "portrait": true,
        "media_alt": "Original portrait footage of the Sideshow Ink Roulette experience",
        "media_width": 432,
        "media_height": 768,
        "button_label": "Book Now",
        "button_link": "/pages/book",
        "second_label": "Our Artists",
        "second_link": "/pages/artists"
      }
    },
