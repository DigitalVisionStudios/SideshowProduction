<!doctype html>
<html lang="{{ request.locale.iso_code | default: 'en' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#080808">
  <title>{{ page_title | default: shop.name | escape }}{% unless page_title contains shop.name %} | {{ shop.name | escape }}{% endunless %}</title>
  {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% else %}<meta name="description" content="Custom tattoos, piercings, tooth gems and teeth whitening at Sideshow Productions in Murray, Utah. Meet the artists and find your next piece.">{% endif %}
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/webp" href="{{ 'sp-logo.webp' | asset_url }}">
  <link rel="preload" as="font" type="font/woff2" href="{{ 'sp-body.woff2' | asset_url }}" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="{{ 'sp-brush.woff2' | asset_url }}" crossorigin>
  {{ 'sideshow-studio.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-menu.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-carousel.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-hero.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-community.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-wheel.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-promo.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-welcome.css' | asset_url | stylesheet_tag }}
  {{ 'sideshow-marquee.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script src="{{ 'sideshow-studio.js' | asset_url }}" defer></script>
  <script src="{{ 'sideshow-carousel.js' | asset_url }}" defer></script>
  <script src="{{ 'sideshow-hero.js' | asset_url }}" defer></script>
  <script src="{{ 'sideshow-wheel.js' | asset_url }}" defer></script>
  <script src="{{ 'sideshow-promo.js' | asset_url }}" defer></script>
  <script src="{{ 'sideshow-marquee.js' | asset_url }}" defer></script>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:image" content="{{ 'sp-storefront.webp' | asset_url }}">
  <meta name="twitter:card" content="summary_large_image">
</head>
<body class="sp-site{% if request.page_type == 'index' or request.path == routes.root_url %} sp-home{% endif %}">
  <a class="sp-skip-link" href="#main-content">Skip to content</a>
  {% section 'studio-header' %}
  <main id="main-content" tabindex="-1">{{ content_for_layout }}</main>
  {% section 'studio-footer' %}
</body>
</html>
