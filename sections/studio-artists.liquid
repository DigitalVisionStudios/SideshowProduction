<section class="sp-section sp-section--dark" id="artists">
  <div class="sp-shell">
    {% unless section.settings.show_details %}<div class="sp-section-heading" data-reveal><h2>{% render 'studio-heading', heading: section.settings.heading, accent: 'ARTISTS.' %}</h2></div>{% endunless %}
    <div class="sp-artist-grid{% if section.settings.show_details %} sp-artist-grid--full{% endif %}">
      {% for block in section.blocks %}<article class="sp-artist-card" id="{{ block.settings.anchor | escape }}" {{ block.shopify_attributes }} data-reveal>
        <a href="{% if section.settings.show_details %}/pages/book#{{ block.settings.anchor | escape }}{% else %}/pages/artists#{{ block.settings.anchor | escape }}{% endif %}" class="sp-artist-photo" aria-label="Meet {{ block.settings.name | escape }}">{% render 'studio-image', image: block.settings.image, asset_name: block.settings.asset, alt: block.settings.alt %}<span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
        <div class="sp-artist-info"><h3>{{ block.settings.name | escape }}</h3><p class="sp-artist-role">{{ block.settings.role | escape }}</p>{% if section.settings.show_details %}<p>{{ block.settings.bio | escape }}</p>{% endif %}
        {% if section.settings.show_details %}
          <details class="sp-artist-details"><summary>Rates &amp; availability{% render 'studio-icon', name: 'chevron', extra_class: 'sp-faq-chevron' %}</summary><div><p><strong>{{ block.settings.rate | escape }}</strong></p><p>{{ block.settings.deposit | escape }}</p><p>{{ block.settings.hours | escape }}</p><p>All times are local to the Murray studio. 48-hour notice for appointment changes. Final availability is confirmed when booking.</p></div></details>
          <a class="sp-link" href="/pages/book#{{ block.settings.anchor | escape }}">Book with {{ block.settings.name | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
        {% else %}
          <a class="sp-link" href="/pages/artists#{{ block.settings.anchor | escape }}">Meet {{ block.settings.name | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
        {% endif %}</div>
      </article>{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Studio artists",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "MEET THE ARTISTS."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Tattoos, piercings, tooth gems, and whitening. Find your artist and view their availability."
    },
    {
      "type": "checkbox",
      "id": "show_details",
      "label": "Show rates and availability",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Artist"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Link anchor",
          "default": "artist"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "TATTOO ARTIST"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait or work image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Fallback image asset",
          "default": "sp-jake.webp"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Artist at Sideshow Productions"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Biography",
          "default": "Find your next piece with our studio."
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Specialties",
          "default": "CUSTOM WORK"
        },
        {
          "type": "text",
          "id": "rate",
          "label": "Rate summary",
          "default": "Contact the studio for pricing"
        },
        {
          "type": "textarea",
          "id": "deposit",
          "label": "Deposit and prices",
          "default": "Confirm details with the studio."
        },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Artist availability",
          "default": "Contact the studio to confirm availability."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio artists",
      "blocks": [
        {
          "type": "artist",
          "settings": {
            "anchor": "jake",
            "name": "Jake",
            "role": "TATTOO ARTIST",
            "asset": "sp-jake.webp",
            "alt": "Jake working on a tattoo at Sideshow",
            "bio": "Custom tattoo work, black and grey, lettering, and fine-line designs.",
            "meta": "CUSTOM TATTOOS · LETTERING",
            "rate": "From $100 / hour",
            "deposit": "$50 deposit, credited toward your total.",
            "hours": "Tuesday & Friday: 4–10 pm. Wednesday, Thursday & Saturday: 3:30–10 pm. No Sunday or Monday appointments."
          }
        },
        {
          "type": "artist",
          "settings": {
            "anchor": "rigo",
            "name": "Rigo",
            "role": "TATTOO ARTIST",
            "asset": "sp-rigo.webp",
            "alt": "Blue floral tattoo work by Rigo",
            "bio": "Custom tattoos and color work. Consultations in English or Spanish.",
            "meta": "ILLUSTRATIVE · ENGLISH / ESPAÑOL",
            "rate": "From $100 / hour",
            "deposit": "$50 deposit, credited toward your total.",
            "hours": "Tuesday–Saturday: 3–8 pm. No Sunday or Monday appointments."
          }
        },
        {
          "type": "artist",
          "settings": {
            "anchor": "sonny",
            "name": "Sonny",
            "role": "PIERCING ARTIST",
            "asset": "sp-sonny.webp",
            "alt": "Ear piercing work by Sonny",
            "bio": "Body piercings and jewelry. Contact Sonny about your placement and availability.",
            "meta": "PIERCINGS · JEWELRY",
            "rate": "Pricing varies by piercing",
            "deposit": "20% deposit. Jewelry included with new piercings.",
            "hours": "Tuesday–Friday: 2–8 pm. Saturday: noon–8 pm. No Sunday or Monday appointments."
          }
        },
        {
          "type": "artist",
          "settings": {
            "anchor": "megan",
            "name": "Megan",
            "role": "TOOTH GEMS & WHITENING",
            "asset": "sp-megan.webp",
            "alt": "Megan at Sideshow Productions",
            "bio": "Tooth gems and teeth whitening. Explore gem options and whitening sessions.",
            "meta": "TOOTH GEMS · TEETH WHITENING",
            "rate": "Tooth gems from $60",
            "deposit": "Additional gems $20 each. Heart/star $65. Fang $100. Whitening: single $89, double $120, triple $200. 20% deposit.",
            "hours": "Tuesday–Saturday: 7–8:30 pm."
          }
        }
      ]
    }
  ]
}
{% endschema %}