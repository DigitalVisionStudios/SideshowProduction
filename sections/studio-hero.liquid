<section class="sp-hero">
  <div class="sp-shell sp-hero-grid">
    <div class="sp-hero-copy">
      <p class="sp-eyebrow"><span class="sp-status-dot" aria-hidden="true"></span> {{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading_line_one | escape }}<br>{{ section.settings.heading_line_two | escape }} <em>{{ section.settings.heading_accent | escape }}</em></h1>
      <p class="sp-intro">{{ section.settings.description | escape }}</p>
      <div class="sp-actions"><a class="sp-button sp-button--red" href="/pages/book">Find your artist <span aria-hidden="true">↗</span></a><a class="sp-link" href="/pages/portfolio">Explore the work <span aria-hidden="true">↓</span></a></div>
      <div class="sp-hero-note"><span class="sp-hero-note-number">01 /</span><span>YOUR IDEAS. OUR HANDS.<br>SOMETHING THAT'S ONLY YOURS.</span></div>
    </div>
    <div class="sp-hero-art">
      {% if section.settings.image != blank %}<img class="sp-hero-image" src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image_alt | escape }}" width="900" height="1100" fetchpriority="high">{% else %}<img class="sp-hero-image" src="{{ 'sp-hero.webp' | asset_url }}" alt="Illustrative linework tattoo from Jake's portfolio at Sideshow Productions" width="900" height="1100" fetchpriority="high">{% endif %}
      <div class="sp-hero-stamp" aria-hidden="true">ONE OF<br>A KIND.</div>
      <div class="sp-photo-caption"><span>REAL WORK. REAL PEOPLE.</span><a href="/pages/artists#jake">In the chair with Jake <span aria-hidden="true">↗</span></a></div>
    </div>
  </div>
</section>
<div class="sp-ticker" aria-label="Our specialties"><span>Custom tattoos</span><span aria-hidden="true">✳</span><span>Piercings</span><span aria-hidden="true">✳</span><span>Tooth gems</span><span aria-hidden="true">✳</span><span>Teeth whitening</span><span aria-hidden="true">✳</span><span>Murray, Utah</span></div>
{% schema %}
{"name":"Studio hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"TATTOOS & MORE · MURRAY, UTAH"},{"type":"text","id":"heading_line_one","label":"First heading line","default":"GOOD PEOPLE."},{"type":"text","id":"heading_line_two","label":"Second heading line","default":"GREAT"},{"type":"text","id":"heading_accent","label":"Accent word","default":"INK."},{"type":"textarea","id":"description","label":"Introduction","default":"A custom piece, a new piercing, a little more you. Find your artist and make yourself at home at Sideshow Productions."},{"type":"image_picker","id":"image","label":"Hero photograph"},{"type":"text","id":"image_alt","label":"Image description","default":"Custom tattoo work at Sideshow Productions"}],"presets":[{"name":"Studio hero"}]}
{% endschema %}
