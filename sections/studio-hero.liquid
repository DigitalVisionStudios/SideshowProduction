{% assign hero_interval = section.settings.interval | default: 5.5 | times: 1000 %}
<section class="sp-hero-deck" data-sp-hero-deck data-hero-interval="{{ hero_interval }}" data-hero-autoplay="{{ section.settings.autoplay }}" aria-labelledby="sp-hero-heading-{{ section.id }}" aria-roledescription="carousel">
  <div class="sp-hero-deck__media" aria-hidden="true">
    {% for block in section.blocks %}
      {% assign hero_asset = block.settings.asset | default: 'sp-source-storefront.webp' %}
      {% if block.settings.image != blank %}
        {% assign hero_src = block.settings.image | image_url: width: 2000 %}
        {% assign hero_width = block.settings.image.width %}
        {% assign hero_height = block.settings.image.height %}
      {% else %}
        {% assign hero_src = hero_asset | asset_url %}
        {% assign hero_width = block.settings.width | default: 1354 %}
        {% assign hero_height = block.settings.height | default: 759 %}
      {% endif %}
      <div class="sp-hero-deck__frame sp-hero-deck__frame--{{ block.settings.media_style | default: 'cover' }}{% if forloop.first %} is-active{% endif %}" data-sp-hero-frame data-block-id="{{ block.id }}" style="--sp-hero-focus-x:{{ block.settings.focus_x | default: 50 }}%;--sp-hero-focus-y:{{ block.settings.focus_y | default: 50 }}%;" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
        <img src="{{ hero_src }}" alt="" width="{{ hero_width }}" height="{{ hero_height }}" decoding="async" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy" fetchpriority="low"{% endif %}>
        {% if section.settings.enable_video and block.settings.video_asset != blank and block.settings.video_asset != '#' %}
          <video data-sp-hero-deck-video muted loop playsinline preload="none" poster="{{ hero_src }}" tabindex="-1" aria-hidden="true">
            <source data-src="{{ block.settings.video_asset | asset_url }}" type="video/mp4">
          </video>
        {% endif %}
      </div>
    {% else %}
      <div class="sp-hero-deck__frame sp-hero-deck__frame--cover is-active" data-sp-hero-frame>
        <img src="{{ 'sp-source-storefront.webp' | asset_url }}" alt="" width="1354" height="759" fetchpriority="high">
      </div>
    {% endfor %}
  </div>
  <div class="sp-hero-deck__ambient" aria-hidden="true"></div>
  <div class="sp-hero-deck__shade" aria-hidden="true"></div>
  <div class="sp-hero-deck__floor" aria-hidden="true"></div>
  <div class="sp-shell sp-hero-deck__content">
    <div class="sp-hero-deck__copy">
      <p class="sp-hero-deck__eyebrow">{{ section.settings.eyebrow | default: 'The Best Tattoo Shop Vibes Murray Utah' | escape }}</p>
      <h1 id="sp-hero-heading-{{ section.id }}">
        <span class="sp-hero-deck__words">
          {% for block in section.blocks %}
            <span class="sp-hero-deck__word{% if forloop.first %} is-active{% endif %}" data-sp-hero-word {% unless forloop.first %}aria-hidden="true" hidden{% endunless %}>{{ block.settings.word | default: 'artists' | escape }}</span>
          {% else %}
            <span class="sp-hero-deck__word is-active" data-sp-hero-word>artists</span>
          {% endfor %}
        </span>
        <span class="sp-hero-deck__suffix">
          {% for block in section.blocks %}
            <span class="sp-hero-deck__line{% if forloop.first %} is-active{% endif %}" data-sp-hero-line {% unless forloop.first %}aria-hidden="true" hidden{% endunless %}>{{ block.settings.heading | default: 'Meet the crew.' | escape }}</span>
          {% else %}
            <span class="sp-hero-deck__line is-active" data-sp-hero-line>Meet the crew.</span>
          {% endfor %}
        </span>
      </h1>
      <p class="sp-hero-deck__intro">
        {% for block in section.blocks %}
          <span class="sp-hero-deck__description{% if forloop.first %} is-active{% endif %}" data-sp-hero-description {% unless forloop.first %}aria-hidden="true" hidden{% endunless %}>{{ block.settings.description | default: 'Explore their work and find the right artist for your next piece.' | escape }}</span>
        {% else %}
          <span class="sp-hero-deck__description is-active" data-sp-hero-description>Explore their work and find the right artist for your next piece.</span>
        {% endfor %}
      </p>
      <div class="sp-actions sp-hero-deck__actions">
        <a class="sp-button sp-button--red" href="{{ section.settings.primary_link | default: '/pages/book' }}">{{ section.settings.primary_label | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
        <a class="sp-button sp-button--outline" href="{{ section.settings.secondary_link | default: '/pages/artists' }}">{{ section.settings.secondary_label | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Studio hero",
  "max_blocks": 6,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Studio tagline","default":"The Best Tattoo Shop Vibes Murray Utah"},
    {"type":"text","id":"primary_label","label":"Booking button","default":"Book Now"},
    {"type":"url","id":"primary_link","label":"Booking destination"},
    {"type":"text","id":"secondary_label","label":"Artists button","default":"Meet the Artists"},
    {"type":"url","id":"secondary_link","label":"Artists destination"},
    {"type":"checkbox","id":"autoplay","label":"Rotate scenes automatically","default":true},
    {"type":"range","id":"interval","label":"Seconds between scenes","min":4,"max":10,"step":0.5,"unit":"s","default":5.5},
    {"type":"checkbox","id":"enable_video","label":"Allow optional scene videos","default":true}
  ],
  "blocks": [
    {
      "type":"scene",
      "name":"Hero scene",
      "settings":[
        {"type":"text","id":"word","label":"Rotating word","default":"artists"},
        {"type":"text","id":"heading","label":"Scene headline","default":"Meet the crew."},
        {"type":"textarea","id":"description","label":"Scene description","default":"Explore their work and find the right artist for your next piece."},
        {"type":"image_picker","id":"image","label":"Optional uploaded photograph"},
        {"type":"text","id":"asset","label":"Fallback photograph asset","default":"sp-source-storefront.webp"},
        {"type":"number","id":"width","label":"Fallback image width","default":1354},
        {"type":"number","id":"height","label":"Fallback image height","default":759},
        {"type":"select","id":"media_style","label":"Photo framing","options":[{"value":"cover","label":"Full background"},{"value":"right","label":"Full photo on the right"}],"default":"cover"},
        {"type":"range","id":"focus_x","label":"Horizontal photo focus","min":0,"max":100,"step":5,"unit":"%","default":50},
        {"type":"range","id":"focus_y","label":"Vertical photo focus","min":0,"max":100,"step":5,"unit":"%","default":50},
        {"type":"text","id":"video_asset","label":"Optional MP4 asset","info":"Use # for a still photograph.","default":"#"}
      ]
    }
  ],
  "presets":[
    {
      "name":"Studio hero",
      "blocks":[
        {"type":"scene","settings":{"word":"artists","heading":"Meet the crew.","description":"Explore their work and find the right artist for your next piece.","asset":"sp-source-storefront.webp","width":1354,"height":759,"media_style":"cover","focus_x":50,"focus_y":50,"video_asset":"#"}},
        {"type":"scene","settings":{"word":"piercings","heading":"Find your next look.","description":"Your first piercing or your next addition, let’s make it yours.","asset":"sp-original-sonny-heart.webp","width":1440,"height":1800,"media_style":"right","focus_x":50,"focus_y":50,"video_asset":"#"}},
        {"type":"scene","settings":{"word":"tattoos","heading":"Made for you.","description":"Bring an idea, choose some flash, or start with a conversation.","asset":"sp-welcome-jake-session.webp","width":750,"height":1000,"media_style":"right","focus_x":50,"focus_y":55,"video_asset":"#"}}
      ]
    }
  ]
}
{% endschema %}
