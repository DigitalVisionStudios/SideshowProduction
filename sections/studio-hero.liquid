<section class="sp-hero" aria-labelledby="sp-hero-heading-{{ section.id }}">
  <div class="sp-hero-media" aria-hidden="true">
    {% if section.settings.image != blank %}
      <img class="sp-hero-poster" src="{{ section.settings.image | image_url: width: 2000 }}" alt="" width="1920" height="1080" fetchpriority="high">
    {% else %}
      <img class="sp-hero-poster" src="{{ 'sp-authentic-hero-poster.webp' | asset_url }}" alt="" width="498" height="246" fetchpriority="high">
      {% if section.settings.show_video %}
        <video data-sp-hero-video muted loop playsinline preload="none" poster="{{ 'sp-authentic-hero-poster.webp' | asset_url }}" tabindex="-1" aria-hidden="true">
          <source data-src="{{ 'sp-authentic-hero.mp4' | asset_url }}" type="video/mp4">
        </video>
      {% endif %}
    {% endif %}
  </div>
  <div class="sp-hero-shade" aria-hidden="true"></div>
  <div class="sp-shell sp-hero-content">
    <div class="sp-hero-copy">
      <h1 id="sp-hero-heading-{{ section.id }}"><span>{{ section.settings.heading_line_one | escape }}</span><em>{{ section.settings.heading_accent | escape }}</em></h1>
      <p class="sp-intro">{{ section.settings.description | escape }}</p>
      <div class="sp-actions">
        <a class="sp-button sp-button--red" href="/pages/book">Book an appointment <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
        <a class="sp-button sp-button--outline" href="/pages/portfolio">View our work <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
      </div>
    </div>
  </div>
  {% if section.settings.show_video and section.settings.image == blank %}
    <div class="sp-hero-controls">
      <button class="sp-video-toggle" type="button" data-sp-video-toggle aria-label="Pause background video" aria-pressed="false" hidden>
        <svg data-sp-video-pause-icon width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" fill="none" stroke="currentColor" stroke-width="3"/></svg>
        <svg data-sp-video-play-icon width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="m8 5 11 7-11 7Z" fill="currentColor"/></svg>
      </button>
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Studio hero",
  "settings": [
    {"type":"text","id":"heading_line_one","label":"First heading line","default":"UNLEASH YOUR"},
    {"type":"text","id":"heading_accent","label":"Brush heading","default":"CREATIVITY."},
    {"type":"textarea","id":"description","label":"Introduction","default":"Custom tattoos, piercings, and more. Sideshow Productions in Murray, Utah."},
    {"type":"checkbox","id":"show_video","label":"Play original studio footage","default":true},
    {"type":"image_picker","id":"image","label":"Optional hero photograph"}
  ],
  "presets": [{"name":"Studio hero"}]
}
{% endschema %}
