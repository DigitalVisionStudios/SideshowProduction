{% comment %}
  Curated client photographs, not a live Instagram feed.
  Studio and artist profile URLs are preserved from archived homepage/About HTML.
  Images retain the artist attribution recorded in page.studio-portfolio.json.
  No individual Instagram post URL was present in the captured source.
{% endcomment %}
{% assign studio_instagram = section.settings.instagram_url | default: 'https://www.instagram.com/sideshowproductionstattoo/' %}
<section class="sp-section sp-community-section sp-social-section" id="social" aria-labelledby="sp-social-heading-{{ section.id }}">
  <div class="sp-shell">
    <div class="sp-section-heading" data-reveal>
      <div>
        <h2 id="sp-social-heading-{{ section.id }}" class="sp-community-heading">{{ section.settings.heading | escape }}</h2>
        {% if section.settings.intro != blank %}<p>{{ section.settings.intro | escape }}</p>{% endif %}
      </div>
      <a class="sp-social-profile" href="{{ studio_instagram | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Sideshow Productions on Instagram, opens in a new tab">
        {% render 'studio-icon', name: 'instagram' %}
        <span>{{ section.settings.instagram_handle | escape }}</span>
        {% render 'studio-icon', name: 'arrow-up-right' %}
      </a>
    </div>
    {% if section.blocks.size > 0 %}
      <div class="sp-social-grid" data-reveal>
        {% for block in section.blocks %}
          {% assign photo_link = block.settings.link_url | default: studio_instagram %}
          <a class="sp-social-tile" href="{{ photo_link | escape }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.link_label | escape }}, opens in a new tab" {{ block.shopify_attributes }}>
            {% render 'studio-image', image: block.settings.image, asset_name: block.settings.asset, alt: block.settings.alt %}
            <span class="sp-social-tile-overlay"><span>{{ block.settings.caption | escape }}</span>{% render 'studio-icon', name: 'instagram' %}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
    <div class="sp-social-footer" data-reveal>
      <a class="sp-button sp-button--outline" href="{{ studio_instagram | escape }}" target="_blank" rel="noopener noreferrer">{% render 'studio-icon', name: 'instagram' %} Follow on Instagram <span class="sp-sr-only">(opens in a new tab)</span></a>
      {% if section.settings.tiktok_url != blank %}
        <a class="sp-social-secondary" href="{{ section.settings.tiktok_url | escape }}" target="_blank" rel="noopener noreferrer">{% render 'studio-icon', name: 'tiktok' %} Find us on TikTok {% render 'studio-icon', name: 'arrow-up-right' %}<span class="sp-sr-only">(opens in a new tab)</span></a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Studio social gallery",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FOLLOW THE SIDESHOW." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Find more work, studio moments, and event updates on Instagram." },
    { "type": "text", "id": "instagram_handle", "label": "Instagram handle", "default": "@sideshowproductionstattoo" },
    { "type": "url", "id": "instagram_url", "label": "Studio Instagram profile" },
    { "type": "url", "id": "tiktok_url", "label": "Studio TikTok profile" }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Client photograph",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "asset", "label": "Fallback asset filename", "default": "sp-work-01.webp" },
        { "type": "text", "id": "alt", "label": "Image description", "default": "Fine-line cowboy boot with flowers by Jake" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Work by Jake" },
        { "type": "url", "id": "link_url", "label": "Verified Instagram profile or post URL" },
        { "type": "text", "id": "link_label", "label": "Accessible link description", "default": "See Jake's work on Instagram" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio social gallery",
      "settings": {
        "instagram_url": "https://www.instagram.com/sideshowproductionstattoo/",
        "tiktok_url": "https://www.tiktok.com/@sshowproductionstattoo"
      },
      "blocks": [
        { "type": "photo", "settings": { "asset": "sp-work-01.webp", "alt": "Fine-line cowboy boot with flowers by Jake", "caption": "Work by Jake", "link_url": "https://www.instagram.com/jakenotlopez", "link_label": "See Jake's work on Instagram" } },
        { "type": "photo", "settings": { "asset": "sp-work-07.webp", "alt": "Script lettering tattoo by Rigo", "caption": "Work by Rigo", "link_url": "https://www.instagram.com/Solo_inkslinger", "link_label": "See Rigo's work on Instagram" } },
        { "type": "photo", "settings": { "asset": "sp-work-11.webp", "alt": "Ear jewelry and piercings shown in Sonny's portfolio", "caption": "Piercings by Sonny", "link_url": "https://www.instagram.com/sonny.27_", "link_label": "See Sonny's work on Instagram" } },
        { "type": "photo", "settings": { "asset": "sp-work-03.webp", "alt": "Swallow and sun linework tattoo by Jake", "caption": "Work by Jake", "link_url": "https://www.instagram.com/jakenotlopez", "link_label": "See Jake's work on Instagram" } },
        { "type": "photo", "settings": { "asset": "sp-work-06.webp", "alt": "A small tooth gem shown in Megan's portfolio", "caption": "Tooth gems by Megan", "link_url": "https://www.instagram.com/meganwell14", "link_label": "See Megan's work on Instagram" } },
        { "type": "photo", "settings": { "asset": "sp-work-10.webp", "alt": "Floral vine linework tattoo by Rigo", "caption": "Work by Rigo", "link_url": "https://www.instagram.com/Solo_inkslinger", "link_label": "See Rigo's work on Instagram" } }
      ]
    }
  ]
}
{% endschema %}
