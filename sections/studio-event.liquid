{% assign now_seconds = 'now' | date: '%s' | plus: 0 %}{% assign expires_seconds = section.settings.expires_at | date: '%s' | plus: 0 %}
{% if section.settings.enabled and expires_seconds > now_seconds %}<section class="sp-event" data-expires="{{ section.settings.expires_at | escape }}"><div class="sp-shell"><span class="sp-tag">{{ section.settings.label | escape }}</span><div><strong>{{ section.settings.title | escape }}</strong><p>{{ section.settings.copy | escape }}</p></div><a class="sp-link" href="{{ section.settings.link | default: '/pages/flash' }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a></div></section>{% endif %}
{% schema %}
{
  "name": "Studio timed event",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show event",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Small label",
      "default": "NOV 13 + 14"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Friday the 13th flash weekend"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Description",
      "default": "Friday: 10 am–8 pm, walk-ins. Saturday: noon–8 pm, appointments."
    },
    {
      "type": "text",
      "id": "expires_at",
      "label": "Hide after (ISO date with timezone)",
      "default": "2026-11-15T03:00:00Z"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Event details link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "View event"
    }
  ],
  "presets": [
    {
      "name": "Studio timed event"
    }
  ]
}
{% endschema %}