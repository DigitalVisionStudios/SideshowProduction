<section class="sp-section sp-section--paper"><div class="sp-shell sp-page-grid"><div class="sp-prose">
{% for block in section.blocks %}<article {{ block.shopify_attributes }} data-reveal>{% if block.settings.kicker != blank %}<p class="sp-eyebrow">{{ block.settings.kicker | escape }}</p>{% endif %}<h2>{{ block.settings.heading | escape }}</h2>{{ block.settings.body }}{% if block.settings.image != blank %}{% render 'studio-image', image: block.settings.image, alt: block.settings.heading %}{% endif %}{% if block.settings.link != blank %}<a class="sp-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}</article>{% endfor %}
</div><aside class="sp-sidebar" data-reveal><img src="{{ 'sp-storefront.webp' | asset_url }}" alt="Sideshow Productions storefront in Murray, Utah" width="1354" height="759" loading="lazy"><p class="sp-eyebrow">YOUR NEIGHBORHOOD STUDIO</p><h3>Murray, Utah.</h3><p>4973 S State St<br>Murray, UT 84107</p><a class="sp-button sp-button--red" href="/pages/book">Meet your artist <span aria-hidden="true">↗</span></a></aside></div></section>
{% schema %}
{"name":"Studio editorial","settings":[],"blocks":[{"type":"story","name":"Story section","settings":[{"type":"text","id":"kicker","label":"Eyebrow","default":"OUR STUDIO"},{"type":"text","id":"heading","label":"Heading","default":"A little different. Just like you."},{"type":"richtext","id":"body","label":"Text","default":"<p>Welcome to Sideshow Productions in Murray, Utah.</p>"},{"type":"image_picker","id":"image","label":"Optional image"},{"type":"url","id":"link","label":"Link"},{"type":"text","id":"link_label","label":"Link label","default":"Explore the studio"}]}],"presets":[{"name":"Studio editorial"}]}
{% endschema %}