<section class="sp-section sp-section--paper"><div class="sp-shell sp-page-grid"><div><h2 class="sp-heading">{{ section.settings.heading | escape }}</h2><a class="sp-link" href="/pages/contact">Talk to the studio <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a></div><div class="sp-faq">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}{% render 'studio-icon', name: 'chevron', extra_class: 'sp-faq-chevron' %}</summary><div class="sp-prose">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}
{"name":"Studio questions","settings":[{"type":"text","id":"heading","label":"Heading","default":"A FEW GOOD QUESTIONS."}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"How do I book?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Find your artist and contact the studio to confirm the right session for you.</p>"}]}],"presets":[{"name":"Studio questions"}]}
{% endschema %}