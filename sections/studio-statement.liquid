<section class="sp-section sp-section--dark sp-studio-section">
  <div class="sp-shell sp-statement">
    <div class="sp-statement-media" data-reveal>
      <img src="{{ 'sp-studio-interior.webp' | asset_url }}" alt="Inside Sideshow Productions tattoo studio in Murray" width="502" height="288" loading="lazy">
    </div>
    <div class="sp-statement-copy" data-reveal>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.copy | escape }}</p>
      <a class="sp-link" href="/pages/about">About Sideshow <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>
    </div>
  </div>
</section>
{% schema %}
{"name":"Studio story","settings":[{"type":"text","id":"heading","label":"Heading","default":"WELCOME TO SIDESHOW."},{"type":"textarea","id":"copy","label":"Studio introduction","default":"Tattoos, piercings, tooth gems, and teeth whitening under one roof in Murray. Meet the artists, explore their work, and bring us your next idea."}],"presets":[{"name":"Studio story"}]}
{% endschema %}
