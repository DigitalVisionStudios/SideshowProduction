<section class="sp-section sp-section--paper" id="shop">
  <div class="sp-shell">
    <div class="sp-section-heading"><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="sp-product-grid">
      {% for block in section.blocks %}
        {% assign item = block.settings.product %}
        {% if item != blank %}
          <a class="sp-product" href="{{ item.url }}" {{ block.shopify_attributes }}>
            {% render 'studio-product-media', image: item.featured_image, asset_name: block.settings.asset, alt: item.title, show_image: block.settings.show_image, background: block.settings.image_background, brand: block.settings.brand, label: block.settings.media_label %}
            <h3>{{ item.title | escape }}</h3>
            <p>{{ item.price | money }}{% unless item.available %} <span>· Sold out</span>{% endunless %}</p>
            <span class="sp-link">View item <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></span>
          </a>
        {% else %}
          <a class="sp-product" href="/pages/contact?item={{ block.settings.title | url_encode }}" {{ block.shopify_attributes }}>
            {% render 'studio-product-media', asset_name: block.settings.asset, alt: block.settings.title, show_image: block.settings.show_image, background: block.settings.image_background, brand: block.settings.brand, label: block.settings.media_label %}
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.price | escape }}{% if block.settings.sold_out %} · Sold out{% endif %}</p>
            <span class="sp-link">{% if block.settings.sold_out %}Ask about restock{% else %}Ask about this item{% endif %} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="sp-notice">Looking for a size, color, or care product? <a href="/pages/contact">Contact the studio</a> for availability.</div>
  </div>
</section>
{% schema %}
{"name":"Studio shop","settings":[{"type":"text","id":"heading","label":"Heading","default":"OFF THE WALL. INTO YOUR WORLD."}],"blocks":[{"type":"item","name":"Shop item","settings":[{"type":"product","id":"product","label":"Shopify product"},{"type":"text","id":"title","label":"Fallback product name","default":"Studio merchandise"},{"type":"text","id":"asset","label":"Fallback image asset","default":"sp-logo.webp"},{"type":"checkbox","id":"show_image","label":"Show fallback product photograph","default":true,"info":"Turn off when the exact product photo is unconfirmed. A connected Shopify product's own photograph takes priority."},{"type":"select","id":"image_background","label":"Photograph background","default":"dark","options":[{"value":"dark","label":"Dark"},{"value":"light","label":"Light"}]},{"type":"text","id":"brand","label":"Text card brand","default":"Sideshow"},{"type":"text","id":"media_label","label":"Text card category","default":"Studio shop"},{"type":"text","id":"price","label":"Fallback price display","default":"Ask the studio for pricing"},{"type":"checkbox","id":"sold_out","label":"Source item was sold out","default":false}]}],"presets":[{"name":"Studio shop"}]}
{% endschema %}
