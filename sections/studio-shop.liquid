<section class="sp-section sp-section--paper" id="shop"><div class="sp-shell">
<div class="sp-section-heading"><div><p class="sp-eyebrow">TAKE A LITTLE SIDESHOW WITH YOU</p><h2>{{ section.settings.heading | escape }}</h2></div><p>Studio merch and aftercare essentials.</p></div>
<div class="sp-product-grid">{% for block in section.blocks %}{% assign item = block.settings.product %}{% if item != blank %}<a class="sp-product" href="{{ item.url }}" {{ block.shopify_attributes }}><img src="{{ item.featured_image | image_url: width: 700 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" width="700" height="800" loading="lazy"><h3>{{ item.title | escape }}</h3><p>{{ item.price | money }}{% unless item.available %} <span>· Sold out</span>{% endunless %}</p><span class="sp-link">View item <span aria-hidden="true">↗</span></span></a>{% else %}<a class="sp-product" href="/pages/contact?item={{ block.settings.title | url_encode }}" {{ block.shopify_attributes }}><img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.title | escape }}" width="700" height="800" loading="lazy"><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.price | escape }}{% if block.settings.sold_out %} · Sold out{% endif %}</p><span class="sp-link">{% if block.settings.sold_out %}Ask about restock{% else %}Ask about this item{% endif %} <span aria-hidden="true">↗</span></span></a>{% endif %}{% endfor %}</div>
<div class="sp-notice">Looking for a size, color, or care product? <a href="/pages/contact">Contact the studio</a> for availability.</div>
</div></section>
{% schema %}
{"name":"Studio shop","settings":[{"type":"text","id":"heading","label":"Heading","default":"OFF THE WALL. INTO YOUR WORLD."}],"blocks":[{"type":"item","name":"Shop item","settings":[{"type":"product","id":"product","label":"Shopify product"},{"type":"text","id":"title","label":"Fallback product name","default":"Studio merchandise"},{"type":"text","id":"asset","label":"Fallback image asset","default":"sp-logo.webp"},{"type":"text","id":"price","label":"Fallback price display","default":"Ask the studio for pricing"},{"type":"checkbox","id":"sold_out","label":"Source item was sold out","default":false}]}],"presets":[{"name":"Studio shop"}]}
{% endschema %}