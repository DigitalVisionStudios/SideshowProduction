<section class="sp-original-section sp-original-artists" id="artists-{{ section.id }}" aria-labelledby="sp-artists-heading-{{ section.id }}">
  <div class="sp-original-artist-intro">
    <div class="sp-original-shell" data-reveal>
      <h2 class="sp-original-title" id="sp-artists-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.intro | escape }}</p>
    </div>
  </div>
  <div class="sp-original-shell">
    <div class="sp-original-artist-carousel splide" data-artist-splide data-scroll-speed="30" role="group" aria-labelledby="sp-artists-heading-{{ section.id }}" tabindex="0">
      <div class="splide__track">
        <ul class="splide__list">
        {% for block in section.blocks %}
          <li class="splide__slide sp-original-artist" data-artist="{{ block.settings.anchor | escape }}" {{ block.shopify_attributes }}>
            <article class="sp-original-artist-card">
            <a class="sp-original-portrait" href="/pages/artists#{{ block.settings.anchor | escape }}" aria-label="Meet {{ block.settings.name | escape }}"><img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt | escape }}" width="360" height="360" loading="lazy" decoding="async"></a>
            <h3><a href="/pages/artists#{{ block.settings.anchor | escape }}">{{ block.settings.name | escape }}</a></h3>
            <p class="sp-original-artist-role">{{ block.settings.role | escape }}</p>
            <p class="sp-original-artist-bio">{{ block.settings.bio | escape }}</p>
            <div class="sp-original-socials">
              {% if block.settings.instagram != blank %}<a href="{{ block.settings.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.name | escape }} on Instagram">{% render 'studio-icon', name: 'instagram' %}</a>{% endif %}
              <a href="/pages/artists#{{ block.settings.anchor | escape }}" aria-label="View {{ block.settings.name | escape }}'s work">{% render 'studio-icon', name: 'gallery' %}</a>
            </div>
            </article>
          </li>
        {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Original artist carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Our Artists"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Discover the talented artists who bring your ideas to life."
    }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        {
          "type": "text",
          "id": "anchor",
          "label": "Artist anchor",
          "default": "artist"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Artist"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Specialty",
          "default": "Tattoo Artist"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Portrait asset",
          "default": "sp-original-portrait-jake.webp"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Artist at Sideshow Productions"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Biography",
          "default": "Meet your next artist."
        },
        {
          "type": "url",
          "id": "instagram",
          "label": "Instagram"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Original artist carousel",
      "blocks": [
        {
          "type": "artist",
          "settings": {
            "anchor": "rigo",
            "name": "Rigo",
            "role": "Tattoo Artist",
            "asset": "sp-original-portrait-rigo.webp",
            "alt": "Rigo at Sideshow Productions",
            "bio": "Works in black-and-grey and illustrative styles with clean lines and smooth blends.",
            "instagram": "https://www.instagram.com/Solo_inkslinger"
          }
        },
        {
          "type": "artist",
          "settings": {
            "anchor": "jake",
            "name": "Jake",
            "role": "Tattoo Artist",
            "asset": "sp-original-portrait-jake.webp",
            "alt": "Jake at Sideshow Productions",
            "bio": "Blends graphic elements with black-and-grey shading for clear, readable designs.",
            "instagram": "https://www.instagram.com/jakenotlopez"
          }
        },
        {
          "type": "artist",
          "settings": {
            "anchor": "megan",
            "name": "Megan",
            "role": "Tooth Gem & Teeth Whitening",
            "asset": "sp-original-portrait-megan.webp",
            "alt": "Megan at Sideshow Productions",
            "bio": "Specializes in cosmetic tooth gems and teeth whitening, providing safe application with quality materials.",
            "instagram": "https://www.instagram.com/meganwell14"
          }
        },
        {
          "type": "artist",
          "settings": {
            "anchor": "sonny",
            "name": "Sonny",
            "role": "Piercing Artist",
            "asset": "sp-original-portrait-sonny.webp",
            "alt": "Sonny at Sideshow Productions",
            "bio": "Provides precise, professional piercings using sterile technique and implant-grade jewelry.",
            "instagram": "https://www.instagram.com/sonny.27_"
          }
        }
      ]
    }
  ]
}
{% endschema %}
