<section class="sp-section sp-services-section" id="services">
  <div class="sp-shell">
    <div class="sp-section-heading" data-reveal><h2>{{ section.settings.heading | escape }}</h2></div>
    <div class="sp-service-list">
      {% for block in section.blocks %}
        <a class="sp-service-row" href="{{ block.settings.link | default: '/pages/book' }}" {{ block.shopify_attributes }} data-reveal>
          <div><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p></div>
          <span class="sp-service-meta">{{ block.settings.note | escape }}</span>
          <span class="sp-arrow" aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Studio services",
  "settings":[{"type":"text","id":"heading","label":"Heading","default":"WHAT WE DO."}],
  "blocks":[{"type":"service","name":"Service","settings":[
    {"type":"text","id":"title","label":"Title","default":"Custom tattoos"},
    {"type":"textarea","id":"description","label":"Description","default":"Custom designs, black and grey, color, and lettering."},
    {"type":"text","id":"note","label":"Artist","default":"Jake & Rigo"},
    {"type":"url","id":"link","label":"Destination"}
  ]}],
  "presets":[{"name":"Studio services","blocks":[
    {"type":"service","settings":{"title":"Custom tattoos","description":"Custom designs, black and grey, color, and lettering.","note":"Jake & Rigo","link":"/pages/artists"}},
    {"type":"service","settings":{"title":"Piercings","description":"Explore placements and jewelry with Sonny.","note":"Sonny","link":"/pages/artists#sonny"}},
    {"type":"service","settings":{"title":"Tooth gems","description":"Crystals, shapes, and individual gem placements.","note":"Megan","link":"/pages/artists#megan"}},
    {"type":"service","settings":{"title":"Teeth whitening","description":"Single, double, and triple sessions with Megan.","note":"Megan","link":"/pages/artists#megan"}}
  ]}]
}
{% endschema %}
