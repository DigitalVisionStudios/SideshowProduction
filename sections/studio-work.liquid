<section class="sp-section sp-section--paper" id="work" data-gallery>
  <div class="sp-shell">
    <div class="sp-section-heading" data-reveal><div><p class="sp-eyebrow">02 / ON SKIN, NOT A MOODBOARD</p><h2>{{ section.settings.heading | escape }}</h2></div>{% unless section.settings.full_gallery %}<a class="sp-link" href="/pages/portfolio">View the whole gallery <span aria-hidden="true">↗</span></a>{% endunless %}</div>
    {% if section.settings.show_filters %}<div class="sp-filters" aria-label="Filter work"><button type="button" data-filter="all" aria-pressed="true">All work</button><button type="button" data-filter="tattoo" aria-pressed="false">Tattoos</button><button type="button" data-filter="piercing" aria-pressed="false">Piercings</button><button type="button" data-filter="gems" aria-pressed="false">Tooth gems</button></div>{% endif %}
    <div class="sp-gallery-grid">
      {% for block in section.blocks %}{% if block.settings.image != blank %}{% assign image_src = block.settings.image | image_url: width: 1600 %}{% else %}{% assign image_src = block.settings.asset | asset_url %}{% endif %}
        <button class="sp-work" type="button" data-lightbox-src="{{ image_src | escape }}" data-lightbox-alt="{{ block.settings.alt | escape }}" data-category="{{ block.settings.category }}" aria-label="Enlarge: {{ block.settings.alt | escape }}" {{ block.shopify_attributes }} data-reveal>
          {% render 'studio-image', image: block.settings.image, asset_name: block.settings.asset, alt: block.settings.alt %}
          <span class="sp-work-caption"><span>{{ block.settings.title | escape }}</span><small>{{ block.settings.artist | escape }} <span aria-hidden="true">↗</span></small></span>
        </button>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Studio selected work",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "LET THE WORK TALK."
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filters",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_gallery",
      "label": "This is the full gallery page",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "work",
      "name": "Portfolio image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Fallback asset filename",
          "default": "sp-work-01.webp"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Tattoo work at Sideshow Productions"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption",
          "default": "Made for you"
        },
        {
          "type": "text",
          "id": "artist",
          "label": "Artist",
          "default": "SIDESHOW"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            {
              "value": "tattoo",
              "label": "Tattoo"
            },
            {
              "value": "piercing",
              "label": "Piercing"
            },
            {
              "value": "gems",
              "label": "Tooth gems"
            }
          ],
          "default": "tattoo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio selected work",
      "blocks": [
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-01.webp",
            "alt": "Fine-line cowboy boot with flowers by Jake",
            "title": "A little western",
            "artist": "JAKE",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-02.webp",
            "alt": "Blue floral tattoo by Rigo",
            "title": "Color that stays with you",
            "artist": "RIGO",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-04.webp",
            "alt": "Heart-shaped ear jewelry in a piercing by Sonny",
            "title": "Small details. Big personality.",
            "artist": "SONNY",
            "category": "piercing"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-03.webp",
            "alt": "Swallow and sun linework tattoo by Jake",
            "title": "Made to move with you",
            "artist": "JAKE",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-05.webp",
            "alt": "Dragon linework tattoo by Jake",
            "title": "Your kind of bold",
            "artist": "JAKE",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-06.webp",
            "alt": "A small tooth gem applied by Megan",
            "title": "A little extra shine",
            "artist": "MEGAN",
            "category": "gems"
          }
        }
      ]
    }
  ]
}
{% endschema %}