<section class="sp-section sp-section--dark sp-work-section" id="work" data-gallery>
  <div class="sp-shell">
    {% unless section.settings.full_gallery %}<div class="sp-section-heading" data-reveal><h2>{{ section.settings.heading | escape }}</h2><a class="sp-link" href="/pages/portfolio">View all work <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a></div>{% endunless %}
    {% if section.settings.show_filters %}<div class="sp-filters" aria-label="Filter work"><button type="button" data-filter="all" aria-pressed="true">All work</button><button type="button" data-filter="tattoo" aria-pressed="false">Tattoos</button><button type="button" data-filter="piercing" aria-pressed="false">Piercings</button><button type="button" data-filter="gems" aria-pressed="false">Tooth gems</button></div>{% endif %}
    <div class="sp-gallery-grid">
      {% for block in section.blocks %}{% if block.settings.image != blank %}{% assign image_src = block.settings.image | image_url: width: 1600 %}{% else %}{% assign image_src = block.settings.asset | asset_url %}{% endif %}
        <button class="sp-work" type="button" data-lightbox-src="{{ image_src | escape }}" data-lightbox-alt="{{ block.settings.alt | escape }}" data-category="{{ block.settings.category }}" aria-label="Enlarge: {{ block.settings.alt | escape }}" {{ block.shopify_attributes }} data-reveal>
          {% render 'studio-image', image: block.settings.image, asset_name: block.settings.asset, alt: block.settings.alt %}
          <span class="sp-work-caption"><span>{{ block.settings.title | escape }}</span><small>{{ block.settings.artist | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></small></span>
        </button>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Studio selected work",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "OUR WORK."
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filters",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_gallery",
      "label": "This is the full gallery page",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "work",
      "name": "Portfolio image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Fallback asset filename",
          "default": "sp-work-01.webp"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Tattoo work at Sideshow Productions"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption",
          "default": "Tattoo work"
        },
        {
          "type": "text",
          "id": "artist",
          "label": "Artist",
          "default": "SIDESHOW"
        },
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            {
              "value": "tattoo",
              "label": "Tattoo"
            },
            {
              "value": "piercing",
              "label": "Piercing"
            },
            {
              "value": "gems",
              "label": "Tooth gems"
            }
          ],
          "default": "tattoo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Studio selected work",
      "blocks": [
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-dark-01.webp",
            "alt": "Bold black grim reaper tattoo with a scythe by Jake",
            "title": "Grim reaper",
            "artist": "JAKE",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-02.webp",
            "alt": "Blue and purple floral tattoo by Rigo",
            "title": "Color florals",
            "artist": "RIGO",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-dark-02.webp",
            "alt": "Two black spider tattoos forming a heart shape by Jake",
            "title": "Spider heart",
            "artist": "JAKE",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-08.webp",
            "alt": "Illustrative blackwork tattoo by Jake",
            "title": "Illustrative blackwork",
            "artist": "JAKE",
            "category": "tattoo"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-04.webp",
            "alt": "Heart-shaped ear jewelry in a piercing by Sonny",
            "title": "Heart jewelry",
            "artist": "SONNY",
            "category": "piercing"
          }
        },
        {
          "type": "work",
          "settings": {
            "asset": "sp-work-12.webp",
            "alt": "Tooth gems shown in Megan’s portfolio",
            "title": "Tooth gems",
            "artist": "MEGAN",
            "category": "gems"
          }
        }
      ]
    }
  ]
}
{% endschema %}