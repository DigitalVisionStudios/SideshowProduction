<section class="sp-original-section sp-original-reviews" aria-labelledby="sp-reviews-heading-{{ section.id }}">
  <div class="sp-original-shell sp-original-split">
    <div class="sp-original-review-intro" data-reveal><p class="sp-original-kicker">{{ section.settings.eyebrow | escape }}</p><h2 class="sp-original-title" id="sp-reviews-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <div class="sp-original-carousel sp-original-review-carousel" data-original-carousel data-interval="4000" data-reveal aria-label="Client reviews" aria-roledescription="carousel">
      <div class="sp-original-track" data-original-track>
        {% for block in section.blocks %}<figure class="sp-original-review" data-original-slide {{ block.shopify_attributes }}>
          <blockquote><p>{{ block.settings.quote | escape }}</p></blockquote>
          <figcaption><span>{{ block.settings.name | escape }}</span><small>{{ block.settings.source | escape }}</small></figcaption>
        </figure>{% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Original reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "What Our Clients Say"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear it straight from our awesome clients"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Review",
          "default": "Read what our clients have to say."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Client",
          "default": "Sideshow client"
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source",
          "default": "Google Review"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Original reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "I love this shop! I've had both tattoos and piercings done here, and they always turn out amazing They have a clean, friendly, and welcoming atmosphere. The staff are all very knowledgeable, professional, and kind. They are also very affordable! Jake and James are my favorite, but I'd recommend any of the artists/piercers there! 100/10!! I know I'll definitely be a long returning client of theirs",
            "name": "Dakota Fuller",
            "source": "A Local Guide | Google Review"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "I absolutely loveeeeee this tattoo shop!! I have gotten my last 3 tattoos from them and my dad has gotten one as well and all the time I have been everyone has been super nice and the environment is very welcoming! Every artist there does amazing work and they are very accommodating. Highly recommend this shop for your next tattoo!",
            "name": "Ashleigh Jensen",
            "source": "A Local Guide | Google Review"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "I know the owner and he’s super dope. He gave me an awesome tattoo and I love it. He’s got a light touch and checked to make sure I was okay throughout the tattoo. He answered all my questions and concerns and I couldn’t be happier with the result of my tat!",
            "name": "Kayla Burnett",
            "source": "Google Review"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "This shop is so clean! Jake was light handed and hit the fine lines of my tattoo are exceptional. A fun warm welcome and very comfortable seating. I'll be back for more ink in the future.",
            "name": "Jessica Repman",
            "source": "Google Review"
          }
        }
      ]
    }
  ]
}
{% endschema %}
