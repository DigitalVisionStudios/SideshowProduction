<section class="sp-section sp-section--paper"><div class="sp-shell">
<div class="sp-booking-grid">
{% for block in section.blocks %}{% if block.type == '@app' %}{% render block %}{% else %}{% assign booking_product = block.settings.product %}<article class="sp-artist-card" id="{{ block.settings.anchor | escape }}" {{ block.shopify_attributes }}>
  <div class="sp-artist-photo">{% render 'studio-image', asset_name: block.settings.asset, alt: block.settings.alt %}</div>
  <div class="sp-artist-info"><h2>{{ block.settings.name | escape }}</h2><p class="sp-artist-role">{{ block.settings.role | escape }}</p><p>{{ block.settings.rate | escape }}</p><p>{{ block.settings.description | escape }}</p>
  {% if section.settings.booking_ready and booking_product != blank %}<a class="sp-button sp-button--red" href="{{ booking_product.url }}">Choose a session <span aria-hidden="true">↗</span></a>{% elsif section.settings.booking_ready and block.settings.booking_url != blank %}<a class="sp-button sp-button--red" href="{{ block.settings.booking_url }}">Choose a session <span aria-hidden="true">↗</span></a>{% else %}<a class="sp-button sp-button--red" href="/pages/contact?artist={{ block.settings.name | url_encode }}">Contact to book <span aria-hidden="true">↗</span></a>{% endif %}
  </div></article>{% endif %}{% endfor %}
</div>
<div class="sp-notice"><p>Not sure where to start? Call <a href="tel:+13855479547">(385) 547-9547</a> and we'll help you find the right person. Artist schedules vary, and published prices are starting prices.</p></div>
</div></section>
{% schema %}
{"name":"Studio booking","settings":[{"type":"checkbox","id":"booking_ready","label":"Verified online booking is active","default":false,"info":"Enable only after checking the exact Shopify store, Meety calendars, service products, deposits and notification delivery."}],"blocks":[{"type":"@app"},{"type":"artist","name":"Booking option","settings":[{"type":"text","id":"anchor","label":"Anchor","default":"artist"},{"type":"text","id":"name","label":"Name","default":"Artist"},{"type":"text","id":"role","label":"Service","default":"TATTOOS"},{"type":"text","id":"asset","label":"Image asset filename","default":"sp-jake.webp"},{"type":"text","id":"alt","label":"Image description","default":"Sideshow Productions artist"},{"type":"text","id":"rate","label":"Price summary","default":"Contact the studio for a quote"},{"type":"textarea","id":"description","label":"Details","default":"Tell us what you have in mind."},{"type":"product","id":"product","label":"Verified Shopify booking product"},{"type":"url","id":"booking_url","label":"Verified booking page (if no product)"}]}],"presets":[{"name":"Studio booking"}]}
{% endschema %}