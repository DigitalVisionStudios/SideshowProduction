<section class="sp-original-section sp-original-pages sp-original-story{% if section.settings.tone == 'red' %} sp-original-pages--red{% endif %}" aria-labelledby="OriginalStory-{{ section.id }}">
  <div class="sp-original-shell">
    <header class="sp-original-story-heading" data-reveal>
      {% if section.settings.kicker != blank and section.settings.kicker != '#' %}<p class="sp-original-kicker">{{ section.settings.kicker | escape }}</p>{% endif %}
      <h2 class="sp-original-title" id="OriginalStory-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% if section.settings.copy != blank and section.settings.copy != '#' %}<p class="sp-original-story-intro">{{ section.settings.copy | escape }}</p>{% endif %}
    </header>
    <div class="sp-original-story-grid sp-original-story-grid--{{ section.settings.columns }}{% if section.settings.compact %} sp-original-story-grid--compact{% endif %}">
      {% for block in section.blocks %}
        <article class="sp-original-story-card{% if block.settings.asset != blank and block.settings.asset != '#' %} sp-original-story-card--photo{% endif %}" {{ block.shopify_attributes }} data-reveal>
          {% if block.settings.asset != blank and block.settings.asset != '#' %}
            <div class="sp-original-story-photo">{% if block.settings.lightbox %}<button class="sp-original-story-photo-button" type="button" data-lightbox-src="{{ block.settings.asset | asset_url }}" data-lightbox-alt="{{ block.settings.alt | escape }}" aria-label="Enlarge {{ block.settings.alt | escape }}">{% endif %}<img src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt | escape }}" width="{{ block.settings.width }}" height="{{ block.settings.height }}" loading="lazy" decoding="async">{% if block.settings.lightbox %}</button>{% endif %}</div>
          {% else %}<span class="sp-original-story-number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{% endif %}
          <div class="sp-original-story-card-copy">
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.copy | escape }}</p>
            {% if block.settings.link_label != blank and block.settings.link_label != '#' %}<a class="sp-original-text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">{% render 'studio-icon', name: 'arrow-up-right' %}</span></a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Original studio stories",
  "settings": [
    {"type":"text","id":"kicker","label":"Eyebrow","default":"Our Journey"},
    {"type":"text","id":"heading","label":"Heading","default":"A Brief Look at Our Studio's Evolution"},
    {"type":"textarea","id":"copy","label":"Introduction","default":"Discover the people, artistry, and community behind Sideshow."},
    {"type":"select","id":"columns","label":"Desktop columns","options":[{"value":"2","label":"Two"},{"value":"3","label":"Three"},{"value":"4","label":"Four"}],"default":"4"},
    {"type":"checkbox","id":"compact","label":"Compact text cards","default":false},
    {"type":"select","id":"tone","label":"Background","options":[{"value":"dark","label":"Dark"},{"value":"red","label":"Soft red gradient"}],"default":"dark"}
  ],
  "blocks": [
    {"type":"story","name":"Story or feature","settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Our story"},
      {"type":"textarea","id":"copy","label":"Copy","default":"Meet the studio and discover your next piece of body art."},
      {"type":"text","id":"asset","label":"Image asset filename","default":"#"},
      {"type":"checkbox","id":"lightbox","label":"Open full image","default":false},
      {"type":"text","id":"alt","label":"Image description","default":"Sideshow Productions studio"},
      {"type":"number","id":"width","label":"Image width","default":800},
      {"type":"number","id":"height","label":"Image height","default":600},
      {"type":"text","id":"link_label","label":"Link label, # hides","default":"#"},
      {"type":"url","id":"link","label":"Link","default":"/pages/about"}
    ]}
  ],
  "presets":[{"name":"Original studio stories"}]
}
{% endschema %}
