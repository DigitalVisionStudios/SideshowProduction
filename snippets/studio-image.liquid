{% if image != blank %}<img class="{{ image_class | escape }}" src="{{ image | image_url: width: 1200 }}" alt="{{ alt | escape }}" width="{{ width | default: 800 }}" height="{{ height | default: 1000 }}" loading="{{ loading | default: 'lazy' }}" decoding="async">{% else %}<img class="{{ image_class | escape }}" src="{{ asset_name | asset_url }}" alt="{{ alt | escape }}" width="{{ width | default: 800 }}" height="{{ height | default: 1000 }}" loading="{{ loading | default: 'lazy' }}" decoding="async">{% endif %}